# ============================================================
# 文谶驿站 · 环境变量示例
# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，请勿提交。
#   cp .env.example .env
# ============================================================

# ---------- 应用 ----------
APP_NAME=文谶驿站 - 开发者开放仓库
APP_URL=https://fohok.xin
APP_TIMEZONE=Asia/Shanghai
# 会话有效期（秒），默认 12 天
SESSION_LIFETIME=1080000

# ---------- 数据库 ----------
DB_HOST=localhost
DB_NAME=open-user
DB_USER=open-user
DB_PASS=
DB_CHARSET=utf8mb4

# ---------- 文谶账户 OAuth（account.fohok.xin） ----------
WENCHAN_OAUTH_APP_ID=
WENCHAN_OAUTH_APP_SECRET=
# 开发者编号（fhkdev_...），用于读取站内信
WENCHAN_DEVELOPER_ID=
WENCHAN_NOTIFICATION_READ_ENABLED=0

# ---------- 极验 ----------
CAPTCHA_ID=
CAPTCHA_KEY=

# ---------- 邮件发信（people-mail API） ----------
MAIL_API_URL=https://people-mail.fohok.xin/
MAIL_AUTH_CODE=
MAIL_FROM_EMAIL=open@fohok.xin
MAIL_FROM_NAME=文谶驿站 - 开发者开放仓库
MAIL_SMTP_HOST=smtp.qiye.aliyun.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=ssl
MAIL_SMTP_USERNAME=open@fohok.xin

# 管理员邮箱，多个用英文逗号分隔
ADMIN_EMAILS=

# ---------- 网页截图 API ----------
WEBSCR_API_URL=https://work.fohok.xin/webscr/api
WEBSCR_API_KEY=

# ---------- RSS 模块 ----------
RESEND_API_KEY=
RESEND_FROM_EMAIL=open-fohok@xgorb.cn
RESEND_FROM_NAME=文谶驿站
SCREENSHOT_API_BASE=https://fohok.xin/webscr/api
SCREENSHOT_API_KEY=
# 订阅源接口密钥（请求头 X-Comm-Key）
X_COMM_KEY=
RSS_LINKS_API_URL=https://blog.fohok.xin/wp-json/linkinterface/v1/get-links
RSS_SITE_BASE_URL=https://fohok.xin/rss
